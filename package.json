{
  "name": "solemate",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "migrate:up": "node --env-file=.env node_modules/node-pg-migrate/bin/node-pg-migrate.js up -m migrations",
    "migrate:down": "node --env-file=.env node_modules/node-pg-migrate/bin/node-pg-migrate.js down -m migrations",
    "migrate:status": "node --env-file=.env scripts/migrate-status.mjs",
    "seed": "node --env-file=.env scripts/seed.js",
    "create-user": "node --env-file=.env scripts/create-user.mjs",
    "reset-pin": "node --env-file=.env scripts/reset-pin.mjs",
    "test:ui": "node --experimental-strip-types --test 'tests/ui-icons.test.mjs' 'tests/ui-design-system.test.mjs'",
    "test:icons": "node --experimental-strip-types --test 'tests/ui-icons.test.mjs'",
    "test:db": "node --env-file=.env scripts/with-test-db.mjs --experimental-strip-types --test 'tests/db-constraints.test.mjs'",
    "test:auth": "START_TEST_SERVER=1 node --env-file=.env scripts/with-test-db.mjs --experimental-strip-types --test 'tests/auth.test.mjs' 'tests/auth-extra.test.mjs'",
    "test": "npm run test:ui; a=$?; npm run test:db; b=$?; npm run test:auth; c=$?; exit $((a || b || c))"

  },
  "dependencies": {
    "argon2": "^0.45.1",
    "lucide-react": "1.67.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "node-pg-migrate": "^7.9.1",
    "pg": "^8.23.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
