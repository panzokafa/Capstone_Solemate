# Contoh konfigurasi lingkungan. SALIN file ini menjadi .env lalu isi nilainya.
# JANGAN commit file .env yang berisi password asli.

# --- Database PostgreSQL (Lokal / Docker) ---
# Nilai-nilai ini dipakai oleh docker-compose.yml saat pengembangan lokal.
POSTGRES_USER=solemate
POSTGRES_PASSWORD=ganti_password_ini
POSTGRES_DB=solemate
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# --- Koneksi Admin / Migrasi / Skrip CLI (HANYA dari mesin lokal) ---
# Dipakai oleh: migrate:up, migrate:down, migrate:status, create-user, reset-pin, seed, with-test-db.
# PENTING: JANGAN memasang DATABASE_URL admin di lingkungan runtime Vercel!
# Untuk Postgres terkelola (Neon), gunakan connection string DIRECT (tanpa -pooler) dengan ?sslmode=require
# saat menjalankan migrasi atau create-user / reset-pin dari terminal lokal.
DATABASE_URL=postgresql://solemate:ganti_password_ini@127.0.0.1:5432/solemate

# Password user terbatas solemate_app (minimal 8 karakter; dipakai migrasi 0003 saat pembuatan role).
APP_DB_PASSWORD=ganti_app_password_ini

# --- Koneksi Runtime Aplikasi Next.js (WAJIB di produksi) ---
# Runtime aplikasi HANYA membaca DATABASE_URL_APP (tanpa fallback ke DATABASE_URL).
# Gunakan user terbatas solemate_app. Di Neon/produksi, gunakan connection string berpooler (-pooler)
# dengan ?sslmode=require. Jangan memakai URL pemilik yang disuntikkan integrasi Marketplace Neon.
DATABASE_URL_APP=postgresql://solemate_app:ganti_app_password_ini@127.0.0.1:5432/solemate

# --- Pengaturan Pool & SSL Database (Opsional) ---
# Default: DB_POOL_MAX=5 (produksi) / 10 (dev); DB_POOL_IDLE_TIMEOUT_MS=5000 (produksi) / 10000 (dev).
# Di produksi SSL otomatis aktif dengan verifikasi sertifikat penuh (DB_SSL=false dan
# DB_SSL_REJECT_UNAUTHORIZED=false ditolak di produksi).
DB_POOL_MAX=
DB_POOL_IDLE_TIMEOUT_MS=
DB_POOL_CONNECTION_TIMEOUT_MS=10000
DB_SSL=
DB_SSL_REJECT_UNAUTHORIZED=

# --- Sesi, Origin & Keamanan ---
# Rahasia penandatanganan sesi (WAJIB minimal 32 karakter acak di produksi, bukan nilai contoh).
SESSION_SECRET=ganti_dengan_string_acak_panjang
# Masa hidup sesi (detik). Default 8 jam (28800).
SESSION_TTL_SECONDS=28800
# Origin publik aplikasi (WAJIB https:// di produksi, mis. https://solemate-demo.vercel.app).
# Boleh lebih dari satu dipisahkan koma. Dipakai oleh penjaga CSRF/Origin pada rute mutasi.
APP_ORIGIN=http://localhost:3000
# Set 'true' jika di belakang reverse proxy tepercaya (X-Forwarded-For dipakai untuk rate-limit IP login).
TRUST_PROXY=false

# --- WhatsApp Gateway (WAHA) ---
# Mode gateway: di produksi WAJIB diisi eksplisit 'waha' atau 'nonaktif' ('mock' hanya untuk tes).
# Jika 'nonaktif': webhook membalas 503, notifikasi keluar dilewati (saklar_mati), dan WAHA_* tidak wajib.
WA_GATEWAY_MODE=waha
# URL instance WAHA (wajib saat WA_GATEWAY_MODE=waha; port 3001 pada docker-compose lokal).
WAHA_BASE_URL=http://127.0.0.1:3001
# Kunci API WAHA untuk autentikasi endpoint REST (wajib saat WA_GATEWAY_MODE=waha di produksi).
WAHA_API_KEY=
# Nama sesi WAHA default.
WAHA_SESSION=default
# Kunci rahasia HMAC-SHA512 untuk validasi webhook masuk (wajib minimal 32 karakter saat WA_GATEWAY_MODE=waha).
WAHA_WEBHOOK_HMAC_KEY=
# Saklar utama notifikasi WhatsApp keluar otomatis (Phase 6B, default false di produksi).
WA_NOTIFIKASI_AKTIF=false
