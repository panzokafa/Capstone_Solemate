# Contoh konfigurasi lingkungan. SALIN file ini menjadi .env lalu isi nilainya.
# JANGAN commit file .env yang berisi password asli.

# --- Database (PostgreSQL) ---
# Nilai-nilai ini dipakai oleh docker-compose.yml dan aplikasi Next.js.
POSTGRES_USER=solemate
POSTGRES_PASSWORD=ganti_password_ini
POSTGRES_DB=solemate
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# String koneksi untuk aplikasi. Dibentuk dari variabel di atas.
# Sesuaikan password di sini juga kalau kamu mengubah POSTGRES_PASSWORD.
DATABASE_URL=postgresql://solemate:ganti_password_ini@127.0.0.1:5432/solemate

# --- User database terbatas untuk aplikasi ---
# Aplikasi memakai user solemate_app (hak terbatas). Migrasi memakai user admin (DATABASE_URL).
# Password minimal 8 karakter. Dipakai migrasi 0003 untuk membuat user ini.
APP_DB_PASSWORD=ganti_app_password_ini
DATABASE_URL_APP=postgresql://solemate_app:ganti_app_password_ini@127.0.0.1:5432/solemate

# --- Sesi & keamanan ---
# Rahasia penandatanganan sesi. GANTI dengan string acak panjang di produksi.
SESSION_SECRET=ganti_dengan_string_acak_panjang
# Masa hidup sesi (detik). Default 8 jam.
SESSION_TTL_SECONDS=28800
# Set 'true' kalau aplikasi di belakang proxy tepercaya (X-Forwarded-For dipakai untuk IP).
TRUST_PROXY=false

# --- WhatsApp Gateway (WAHA) ---
# URL instance WAHA (port 3001 pada docker-compose).
WAHA_BASE_URL=http://127.0.0.1:3001
# Kunci API WAHA untuk autentikasi endpoint REST (wajib diisi di produksi).
WAHA_API_KEY=
# Nama sesi WAHA default.
WAHA_SESSION=default
# Kunci rahasia HMAC-SHA512 untuk validasi webhook masuk (minimal 32 karakter acak).
WAHA_WEBHOOK_HMAC_KEY=
# Alat diagnosis sementara (dev-only): catat struktur skema payload tanpa nilai jika bernilai 'true'.
WA_LOG_PAYLOAD_STRUCTURE=
