# Contoh konfigurasi lingkungan. SALIN file ini menjadi .env lalu isi nilainya.
# JANGAN commit file .env yang berisi password asli.

# --- Database (PostgreSQL) ---
# Nilai-nilai ini dipakai oleh docker-compose.yml dan aplikasi Next.js.
POSTGRES_USER=solemate
POSTGRES_PASSWORD=ganti_password_ini
POSTGRES_DB=solemate
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# String koneksi untuk aplikasi. Dibentuk dari variabel di atas.
# Sesuaikan password di sini juga kalau kamu mengubah POSTGRES_PASSWORD.
DATABASE_URL=postgresql://solemate:ganti_password_ini@127.0.0.1:5432/solemate
